diff -ruN -x 'build-*' -x '*.before-pacing' sdl-pristine/SDL2-2.0.14/src/events/sf3500/SDL_sf3500input.h SDL2-2.0.14/src/events/sf3500/SDL_sf3500input.h
--- a/src/events/sf3500/SDL_sf3500input.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/events/sf3500/SDL_sf3500input.h	2026-10-10 22:28:36.911215900 -0500
@@ -0,0 +1,34 @@
+/* SF3500 synthetic-keyboard input bridge.
+ *
+ * SORR (BennuGD/libkey.c) reads input via SDL_GetKeyboardState(), which
+ * only reflects reality when something calls SDL_SendKeyboardKey() - which
+ * normally happens inside a real video backend's own event pump (X11,
+ * Windows' WndProc, etc). This device's VIDEO_DUMMY driver never does
+ * that, and there is no real keyboard anyway - input is the joykey.c
+ * shared-memory gamepad. This bridges the two: call
+ * SF3500_PumpJoykeyKeyboard() once per frame (from libsdlhandler's
+ * existing per-frame hook) and it calls SDL_SendKeyboardKey() for the
+ * scancodes SORR's own sorr.gptk control mapping expects, so libkey.c
+ * needs zero changes - same "thin adapter, patch nothing downstream"
+ * shape as the hwaudio SDL2 driver. See sorr_handoff project memory. */
+#include "../../SDL_internal.h"
+
+#ifndef SDL_sf3500input_h_
+#define SDL_sf3500input_h_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Returns the raw joykey_read() bitmask for this frame, so the caller can
+ * also check for the standing SF3500 exit combo (SELECT+START) without a
+ * second joykey_read() call - see sf3500_port_pipeline_recipe project
+ * memory: never trust a game's own in-built quit path on this device. */
+unsigned int SF3500_PumpJoykeyKeyboard(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
+/* vi: set ts=4 sw=4 expandtab: */
