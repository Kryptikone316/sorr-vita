diff -ruN -x 'build-*' -x '*.before-pacing' sdl-pristine/SDL2-2.0.14/src/events/sf3500/joykey.c SDL2-2.0.14/src/events/sf3500/joykey.c
--- a/src/events/sf3500/joykey.c	1969-12-31 18:00:00.000000000 -0600
+++ b/src/events/sf3500/joykey.c	2026-10-10 22:25:37.375257157 -0500
@@ -0,0 +1,61 @@
+/* See joykey.h. Default bit table lifted from TreeFrogUI's own
+ * apps/image_viewer/image_viewer.c (same device, same shared-memory reader),
+ * with the same optional /mnt/sdcard/frogui/keymap.txt override so this
+ * respects whatever button remapping the user has already configured. */
+#include "joykey.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <sys/ipc.h>
+#include <sys/shm.h>
+
+#define KEYMAP_FILE "/mnt/sdcard/frogui/keymap.txt"
+
+static const char *key_names[JK_COUNT] = {
+    "LEFT", "RIGHT", "UP", "DOWN", "A", "B", "L1", "R1", "X", "Y", "START", "SELECT"
+};
+static int key_bits[JK_COUNT] = { 7, 5, 2, 3, 13, 14, 10, 11, 12, 15, 1, 0 };
+
+static volatile unsigned int *cv_keys = NULL;
+
+static void load_keymap(void) {
+    FILE *f = fopen(KEYMAP_FILE, "r");
+    char line[64], name[32];
+    int bit, i;
+    if (!f) return;
+    while (fgets(line, sizeof(line), f)) {
+        if (sscanf(line, "%31[^=]=%d", name, &bit) != 2) continue;
+        for (i = 0; i < JK_COUNT; i++)
+            if (strcmp(name, key_names[i]) == 0 && bit >= 0 && bit < 32) key_bits[i] = bit;
+    }
+    fclose(f);
+}
+
+void joykey_init(void) {
+    key_t key;
+    int id;
+    void *mem;
+
+    load_keymap();
+
+    key = ftok("/tmp/joy_key", 'a');
+    if (key == (key_t)-1) return;
+    id = shmget(key, 4, 0666);
+    if (id < 0) return;
+    mem = shmat(id, NULL, 0);
+    if (mem != (void *)-1) cv_keys = (volatile unsigned int *)mem;
+}
+
+unsigned int joykey_read(void) {
+    unsigned int raw, out;
+    int i;
+
+    if (!cv_keys) return 0;
+
+    raw = *cv_keys & 0xFFFFu;
+    out = 0;
+    for (i = 0; i < JK_COUNT; i++) {
+        if (raw & (1u << key_bits[i])) out |= 1u << i;
+    }
+    return out;
+}
diff -ruN -x 'build-*' -x '*.before-pacing' sdl-pristine/SDL2-2.0.14/src/events/sf3500/joykey.h SDL2-2.0.14/src/events/sf3500/joykey.h
--- a/src/events/sf3500/joykey.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/events/sf3500/joykey.h	2026-10-10 22:25:37.379257155 -0500
@@ -0,0 +1,32 @@
+/* Real gamepad input via cubevol's /tmp/joy_key shared memory - the same
+ * mechanism picoarch/FrogUI/the stock apps use on this device (confirmed via
+ * TreeFrogUI's own docs/dev/standalone-apps.md and source, e.g.
+ * apps/image_viewer/image_viewer.c). No uinput, no uncertain SDL joystick
+ * enumeration - this is the proven, working path. hcprojector (the stock
+ * evdev owner) isn't running during a standalone app, so raw evdev isn't an
+ * option anyway; this shared segment is what's actually populated. */
+#ifndef SF3000_JOYKEY_H
+#define SF3000_JOYKEY_H
+
+enum {
+    JK_LEFT, JK_RIGHT, JK_UP, JK_DOWN,
+    JK_A, JK_B, JK_L1, JK_R1, JK_X, JK_Y,
+    JK_START, JK_SELECT, JK_COUNT
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Attaches the shared memory segment. Safe to call once at startup; silently
+ * leaves the reader inert (always returns 0) if unavailable. */
+void joykey_init(void);
+
+/* Current button state, one bit per JK_* enum value (1 = held). */
+unsigned int joykey_read(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff -ruN -x 'build-*' -x '*.before-pacing' sdl-pristine/SDL2-2.0.14/src/events/sf3500/SDL_sf3500input.c SDL2-2.0.14/src/events/sf3500/SDL_sf3500input.c
--- a/src/events/sf3500/SDL_sf3500input.c	1969-12-31 18:00:00.000000000 -0600
+++ b/src/events/sf3500/SDL_sf3500input.c	2026-10-11 05:36:36.149849100 -0500
@@ -0,0 +1,68 @@
+#include "../../SDL_internal.h"
+
+#if SDL_AUDIO_DRIVER_HWAUDIO /* this build is SF3500-specific either way */
+
+#include "SDL_sf3500input.h"
+#include "../SDL_keyboard_c.h"
+#include "joykey.h"
+#ifndef _WIN32
+#include <unistd.h>
+#include <stdio.h>
+#endif
+
+/* Mapping taken directly from the staged PortMaster package's own
+ * sorr.gptk control file (back=esc, start=enter, a=v, b=c, x=x, y=a,
+ * l1=b, r1=d, arrows=arrows) - this device's joykey.h enum has no
+ * L2/R2/L3/R3/analog bits (no physical buttons for them), so those
+ * gptk entries are irrelevant here; everything joykey.h DOES expose
+ * is covered below. */
+static const SDL_Scancode jk_scancode[JK_COUNT] = {
+    SDL_SCANCODE_LEFT,    /* JK_LEFT */
+    SDL_SCANCODE_RIGHT,   /* JK_RIGHT */
+    SDL_SCANCODE_UP,      /* JK_UP */
+    SDL_SCANCODE_DOWN,    /* JK_DOWN */
+    SDL_SCANCODE_V,       /* JK_A  (a = v) */
+    SDL_SCANCODE_C,       /* JK_B  (b = c) */
+    SDL_SCANCODE_B,       /* JK_L1 (l1 = b) */
+    SDL_SCANCODE_D,       /* JK_R1 (r1 = d) */
+    SDL_SCANCODE_X,       /* JK_X  (x = x) */
+    SDL_SCANCODE_A,       /* JK_Y  (y = a) */
+    SDL_SCANCODE_RETURN,  /* JK_START  (start = enter) */
+    SDL_SCANCODE_ESCAPE   /* JK_SELECT (back = esc) */
+};
+
+unsigned int
+SF3500_PumpJoykeyKeyboard(void)
+{
+    static int initialized = 0;
+    unsigned int bits;
+    int i;
+
+    if (!initialized) {
+        joykey_init();
+        initialized = 1;
+#ifndef _WIN32
+        {
+            /* One-time only (gated by `initialized`) - intentional, keep it.
+             * A per-frame "bits=0x%x" trace used to live right after
+             * joykey_read() below; it caused a real, measured stutter
+             * (write() syscall on every frame any button was held) and was
+             * removed. Do not add a per-call debug write in this function
+             * again without throttling it (once/sec, like
+             * libsdlhandler.c's dump_new_events() does) - see
+             * sorr-vita/CHANGELOG.md item 2 and 6. */
+            const char *msg = "SF3500_PumpJoykeyKeyboard: first call, joykey_init done\n";
+            write(2, msg, SDL_strlen(msg));
+        }
+#endif
+    }
+
+    bits = joykey_read();
+    for (i = 0; i < JK_COUNT; i++) {
+        SDL_SendKeyboardKey((bits & (1u << i)) ? SDL_PRESSED : SDL_RELEASED, jk_scancode[i]);
+    }
+    return bits;
+}
+
+#endif /* SDL_AUDIO_DRIVER_HWAUDIO */
